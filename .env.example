# ==============================================================================
# FREELANCER CRM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# [Database Configuration]
# SQLite (Default): file:./data/freelancercrm.db
# PostgreSQL: postgres://username:password@localhost:5432/freelancercrm
DATABASE_URL=file:./data/freelancercrm.db

# [Security & Operator Gate]
# Optional: Set a secret passcode to lock the CRM behind an operator gate.
# If unset or empty, the workspace runs in open local developer mode.
AUTH_SECRET=

# [Operator Identity (Customizable)]
# Name displayed in topbar, sidebar, calendar attendees, and greetings
NEXT_PUBLIC_OPERATOR_NAME="Alex Rivera"

# Operator email displayed in Settings and profile cards
NEXT_PUBLIC_OPERATOR_EMAIL="alex@example.com"

# Professional role title (e.g. "Full-Stack Engineer", "UI/UX Designer")
NEXT_PUBLIC_OPERATOR_ROLE="Full-Stack & Product Engineer"

# Browser tab and title bar branding
NEXT_PUBLIC_APP_TITLE="Freelancer CRM"

# [Currency & Regional Settings]
# Currency code (e.g. USD, EUR, GBP, CZK)
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# Currency symbol (e.g. $, €, £, Kč)
NEXT_PUBLIC_CURRENCY_SYMBOL="$"

# Locale formatting for numbers & dates (e.g. en-US, en-GB, de-DE, cs-CZ)
NEXT_PUBLIC_LOCALE="en-US"
